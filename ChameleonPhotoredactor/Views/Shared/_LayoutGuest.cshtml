@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.NativeName })
        .ToList();
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Chameleon Editor</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@40,400,0,0" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">


    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/guest.css" />
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="~/css/editor.css" />

    <script src="~/js/site.js"></script>
</head>

<body>
    <div class="guest-layout">
        <nav class="guest-nav">
            <a asp-controller="Home" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                <div class="logo-container">
                    <img class="logo-img" src="/images/logo.png" alt="Chameleon" width="50" />
                </div>
                @Localizer["Home"]
            </a>

            <a asp-controller="Account" asp-action="Login"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")">
                <div class="login-container">
                    <span class="material-symbols-outlined" style="font-size: 24px;">login</span>
                </div>
                @Localizer["Sign in"]
            </a>

            <div style="float:right; margin: 10px;">
                <form asp-controller="Home" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl"
                      method="post" class="form-horizontal">
                    <select name="culture" onchange="this.form.submit();"
                            asp-for="@requestCulture.RequestCulture.UICulture.Name"
                            asp-items="cultureItems">
                    </select>
                </form>
            </div>
        </nav>

        <main class="guest-main">
            @RenderBody()
            @RenderSection("Scripts", required: false)
        </main>
    </div>

    <footer>
        <p>&copy; Chameleon 2025 - @Localizer["Your Photo Editor"]</p>
    </footer>
</body>
</html>